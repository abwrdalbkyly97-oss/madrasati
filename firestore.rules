rules_version = '2';

// قواعد الأمان لتطبيق «مدرستي»
// انسخ هذا الملف كاملاً والصقه في: Firebase Console > Firestore Database > Rules ثم Publish
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function role() { return me().role; }
    function isOwner() { return hasProfile() && role() == 'owner'; }
    function isAdmin() { return hasProfile() && role() in ['owner', 'admin']; }
    function isManager() { return hasProfile() && role() in ['owner', 'admin', 'principal']; }
    function isStaff() { return hasProfile() && role() in ['owner', 'admin', 'principal', 'teacher']; }
    function setupDone() { return exists(/databases/$(db)/documents/meta/setup); }

    // الأدوار التي تستطيع الإدارة إنشاءها، والمشرف يستطيع كل الأدوار
    function canManageRole(r) {
      return isOwner() || (isAdmin() && r in ['teacher', 'student', 'parent']);
    }

    // هل يحق للمستخدم رؤية بيانات هذا الفصل؟
    function canSeeClass(classId) {
      return isStaff()
        || (hasProfile() && me().get('classId', '') == classId)
        || (hasProfile() && classId in me().get('childClassIds', []));
    }

    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !setupDone() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isStaff()
        || (signedIn() && request.auth.uid == uid)
        || (signedIn() && resource.data.parentUid == request.auth.uid);
      allow create: if (signedIn() && request.auth.uid == uid && !setupDone() && request.resource.data.role == 'owner')
        || canManageRole(request.resource.data.role);
      allow update: if canManageRole(resource.data.role) && canManageRole(request.resource.data.role);
      allow delete: if canManageRole(resource.data.role);
    }

    match /credentials/{uid} {
      allow read: if canManageRole(resource.data.role) || (signedIn() && request.auth.uid == uid);
      allow create: if canManageRole(request.resource.data.role)
        || (signedIn() && request.auth.uid == uid && !setupDone());
      allow update: if canManageRole(resource.data.role)
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if canManageRole(resource.data.role);
    }

    match /classes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /timetables/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if canSeeClass(resource.data.classId);
      allow write: if isStaff();
    }

    match /assessments/{id} {
      allow read: if canSeeClass(resource.data.classId);
      allow write: if isStaff();
    }

    match /homework/{id} {
      allow read: if canSeeClass(resource.data.classId);
      allow write: if isStaff();
    }

    match /lessons/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isStaff() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isManager() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /notifications/{id} {
      allow read: if (signedIn() && resource.data.toUid == request.auth.uid) || isManager();
      allow create: if isStaff();
      allow update: if signedIn() && resource.data.toUid == request.auth.uid;
      allow delete: if (signedIn() && resource.data.toUid == request.auth.uid) || isAdmin();
    }
  }
}
